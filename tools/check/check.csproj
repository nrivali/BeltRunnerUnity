<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the game scripts against a stub of the Unity API, so syntax and type errors show up without an editor.
       dotnet build with tools/check from the project root. It proves nothing about behaviour. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Library</OutputType>
    <NoWarn>CS0649;CS0414;CS0169;CS8632;CS0108</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="../../Assets/Scripts/**/*.cs" />
  </ItemGroup>
</Project>
